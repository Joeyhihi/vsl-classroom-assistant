# VSL Classroom Assistant — environment variables (copy to .env; bootstrap does this).
# Never put secrets here; the MVP needs none. See docs/CROSS_PLATFORM_SETUP.md §5.

# --- Backend ---
VSL_ENV=dev                         # dev | prod  (mock mode requires dev)
VSL_HOST=127.0.0.1                  # loopback only (ADR-006)
VSL_PORT=8000
VSL_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VSL_MODEL_MODE=mock                 # mock | template | onnx  (M1 Mac: always mock)
VSL_MOCK_SCRIPT=cycle               # cycle | timer
VSL_SIGN_MODEL_ID=                  # resolves to model-artifacts/sign/<id>/ (Phase 3+)
VSL_DATA_ROOT=                      # empty = platform user-data dir, always outside the repo
VSL_SERVER_EXTRACTION_ENABLED=false # L3 server-side MediaPipe (Phase 3+, Windows)
VSL_HOLISTIC_MODEL_PATH=apps/web/public/mediapipe/holistic_landmarker.task
VSL_COOLDOWN_MS=1500                # suppress the same sign repeated within this window
VSL_STT_ENABLED=false               # Phase 7
VSL_STT_MODEL=small
VSL_STT_DEVICE=cpu
VSL_STT_COMPUTE_TYPE=int8
VSL_HEAVY_MODEL_IDLE_UNLOAD_S=300
VSL_MIN_FREE_RAM_MB=1500
VSL_MIN_FREE_VRAM_MB=1500
VSL_MAX_SESSION_S=7200
VSL_LOG_LEVEL=INFO

# --- Frontend (Vite exposes only VITE_*) ---
VITE_API_BASE=/api/v1
VITE_LANDMARK_SOURCE=replay         # camera | replay  (M1 Mac: replay)
VITE_MIN_FPS=15
VITE_ENABLE_RECORDER=false
